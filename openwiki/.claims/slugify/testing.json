        }
      ]
    },
    {
      "id": "claim_0cab8cee55b348838feaafcf94b23851",
      "statement": "test_mixed_case pins the transliteration map's case handling by requiring uppercase umlauts to produce the same lowercase output as their lowercase counterparts — slugify(\"MÜLLER\"), slugify(\"müller\"), and slugify(\"Müller\") all equal \"mueller\" — which depends both on the uppercase map entries (Ä→Ae, Ö→Oe, Ü→Ue) and on lowercasing running after the map (the uppercase entries expand to capitalized forms like Ue, which only the lowercase stage folds to mueller).",
      "evidence": [
        {
          "resource": "repo://slugify.py#L29-L31",
