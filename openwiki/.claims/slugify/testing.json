    {
      "id": "claim_31fedea7f80f42b293bb2fe804dca40c",
      "statement": "Because this suite is the repository's only automated check (no CI, no other callers), any change to the transliteration map or the NFKD/ASCII normalization step in slugify.py must be paired with a corresponding test update in test_slugify.py: new map entries extend the umlaut/sharp-s methods, ß changes update test_sharp_s_transliteration, uppercase-entry changes update test_mixed_case, normalization changes update test_unicode_normalization (and re-check the empty/special-only group), and regex or trim changes update the separator, boundary, empty, and idempotency groups; genuinely new behavior gets a new test method in the same file.",
      "evidence": [
        {
          "resource": "repo://slugify.py#L24-L49",
          "version": "repo-lines-v1:sha256:a960ee52afa5156ecf9a021ee573ef3c0ce1dccfbe91e3c870800302a833deab:"
