    {
      "id": "claim_97f86d4bafc5490893eb8de97895d40a",
      "statement": "The empty/special-only group (test_empty_string, test_only_special_chars) plus test_no_leading_trailing_hyphens guarantee the output is never a bare \"-\" or punctuation-only slug: \"\", \"   \", \"@#$%\", and \"!!!\" all return \"\" (empty input short-circuits at the guard; whitespace/punctuation-only input collapses to one hyphen that trim removes), and boundary separators (-Hello-, ---Hello---, \" Hello \") never leak into the output.",
      "evidence": [
        {
          "resource": "repo://slugify.py#L20-L21",
